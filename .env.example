# --- Base de datos ---
# Cadena de conexión de Postgres (recomendado: proyecto gratis en https://neon.tech)
DATABASE_URL="postgresql://usuario:password@host/dbname?sslmode=require"

# --- Autenticación (un solo usuario) ---
# PIN o contraseña con la que entras a la app. Se hashea al correr el seed, nunca se guarda en texto plano.
AUTH_PIN="123456"
# Secreto para firmar los JWT de sesión. Genera uno propio, por ejemplo con: openssl rand -hex 32
JWT_SECRET="cambia-este-valor-por-uno-aleatorio-y-largo"

# --- Servidor ---
PORT=4000
NODE_ENV=development
# true en producción (HTTPS). Ponlo en false SOLO para probar por HTTP en tu
# red local (ej. la app Android apuntando a http://192.168.x.x:4000) — si no,
# el navegador/WebView descarta la cookie de sesión y el login "funciona"
# pero las demás peticiones quedan sin autenticar.
COOKIE_SECURE=true

# --- Integración bancaria ---
# "mock" (por defecto, no requiere credenciales) o "belvo"
BANK_PROVIDER=mock
# Solo si BANK_PROVIDER=belvo (ver https://developers.belvo.com)
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_ENV=sandbox
# Cada cuántas horas se sincroniza automáticamente con el banco
BANK_SYNC_INTERVAL_HOURS=6
