{
  "name": "finanzas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev --prefix server\" \"npm:dev --prefix client\"",
    "install:all": "npm install --include=dev --prefix server && npm install --include=dev --prefix client",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@neon/config": "^1.4.3",
    "@neon/env": "^1.3.3"
  }
}
